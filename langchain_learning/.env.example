# Copy this file to ../.env or project-root .env, then fill your values.
# The project .gitignore already ignores .env.

# Most OpenAI-compatible gateways only need these three values.
LABAGENT_LEARNING_MODEL=your-model-name
LABAGENT_LEARNING_BASE_URL=https://your-server.example.com/v1
LABAGENT_LEARNING_API_KEY=your-key

# Keep this as openai for OpenAI-compatible APIs.
# You only need to change it when you are using another LangChain provider.
LABAGENT_LEARNING_PROVIDER=openai

# Most compatible gateways support Chat Completions, not Responses API.
# Set true only if your server explicitly supports OpenAI Responses API.
LABAGENT_LEARNING_USE_RESPONSES_API=false

